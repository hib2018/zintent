{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zintent.local/schemas/approval-confirmation-1.0.0.json",
  "title": "zintent Approval Confirmation Capability 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token_id",
    "intent_id",
    "confirmed_revision_id",
    "confirmed_revision_hash",
    "approved_content_hash",
    "actor_id",
    "issued_at",
    "expires_at",
    "challenge",
    "interactive_tty",
    "consumed"
  ],
  "properties": {
    "token_id": {"type": "string", "format": "uuid"},
    "intent_id": {"type": "string", "format": "uuid"},
    "confirmed_revision_id": {"type": "string", "format": "uuid"},
    "confirmed_revision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "challenge": {"type": "string", "minLength": 6},
    "interactive_tty": {"const": true},
    "consumed": {"const": false}
  }
}
