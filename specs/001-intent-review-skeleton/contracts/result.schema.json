{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zintent.local/schemas/result-1.0.0.json",
  "title": "zintent Command Result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "ok", "operation", "affected_ids", "findings"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "ok": {"type": "boolean"},
    "operation": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "format": "uuid"},
    "previous_revision_id": {"type": "string", "format": "uuid"},
    "resulting_revision_id": {"type": "string", "format": "uuid"},
    "current_revision_id": {"type": "string", "format": "uuid"},
    "affected_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "data": {"$ref": "#/$defs/resultData"},
    "error": {"$ref": "#/$defs/error"}
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {"not": {"required": ["error"]}}
    },
    {
      "if": {"properties": {"ok": {"const": false}}},
      "then": {"required": ["error"]}
    }
  ],
  "$defs": {
    "resultData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {"$ref": "intent.schema.json"},
        "head": {"$ref": "head.schema.json"},
        "edit_preview": {"$ref": "edit-preview.schema.json"},
        "approval_confirmation": {"$ref": "approval-confirmation.schema.json"},
        "snapshot": {"$ref": "snapshot.schema.json"},
        "snapshot_path": {"type": "string", "minLength": 1},
        "diff": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_type", "record_id", "change_type", "before", "after"],
            "properties": {
              "record_type": {"enum": ["intent", "item", "comment", "approval"]},
              "record_id": {"type": "string", "minLength": 1},
              "change_type": {"enum": ["added", "modified", "removed"]},
              "before": {},
              "after": {}
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stream_bytes", "deadline_seconds"],
          "properties": {
            "stream_bytes": {"const": 16777216},
            "deadline_seconds": {"const": 10}
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["blocking", "warning", "info"]},
        "record_type": {"type": ["string", "null"]},
        "record_id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
