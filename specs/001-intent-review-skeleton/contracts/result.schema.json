{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zintent.local/schemas/result-1.0.0.json",
  "title": "zintent Command Result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "ok", "operation", "affected_ids", "findings"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "ok": {"type": "boolean"},
    "operation": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "format": "uuid"},
    "previous_revision_id": {"type": "string", "format": "uuid"},
    "resulting_revision_id": {"type": "string", "format": "uuid"},
    "current_revision_id": {"type": "string", "format": "uuid"},
    "affected_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "data": {"type": "object"},
    "error": {"$ref": "#/$defs/error"}
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {"not": {"required": ["error"]}}
    },
    {
      "if": {"properties": {"ok": {"const": false}}},
      "then": {"required": ["error"]}
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["blocking", "warning", "info"]},
        "record_type": {"type": ["string", "null"]},
        "record_id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
